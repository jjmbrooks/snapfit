{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "snapfit/manifest.schema.json",
  "title": "SnapFit · manifest.json (metadatos y assets de un paquete de historia)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "author",
    "license",
    "status",
    "defaultTheme"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "retired"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 240
    },
    "preview": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)(?!https?:)(?:/art/|(?!/))[A-Za-z0-9_./-]+\\.(png|jpg|jpeg|webp|gif|svg|mp4|webm|ogg|mp3|m4a)$",
      "description": "Ruta relativa a public/stories/<id>/, o absoluta /art/<carpeta>/… (relativa a public/)"
    },
    "defaultTheme": {
      "type": "string",
      "enum": [
        "medianoche",
        "manana",
        "chicle",
        "selva",
        "pacifico",
        "volcan"
      ]
    },
