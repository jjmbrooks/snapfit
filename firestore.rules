rules_version = '2';
// SnapFit — reglas por uid (docs/02-ARCHITECTURE.md §4.2).
// Publicar: pegar en Firebase Console > Firestore > Reglas, o `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validEvent(eventId) {
      let d = request.resource.data;
      return d.id == eventId
        && d.id is string && d.id.size() == 26
        && d.type in ['card_done', 'card_skipped', 'effort_rated', 'level_changed', 'badge_unlocked', 'settings_changed']
        && d.v is int
        && d.ts is string
        && d.serverAt == request.time
        && request.resource.data.keys().size() <= 20;
    }

    function validProfile(p) {
      return p.keys().hasOnly(['age', 'sex', 'fitness', 'test', 'deckId', 'baseLevels', 'termsAt', 'updatedAt'])
        && (!('age' in p) || (p.age is int && p.age >= 13 && p.age <= 100))
        && (!('sex' in p) || p.sex in ['mujer', 'hombre', 'otro', 'prefiero-no-decir'])
        && (!('fitness' in p) || p.fitness in ['sedentario', 'ligero', 'activo', 'muy-activo']);
    }

    // Ajustes sincronizados: solo ids (la historia es un paquete; aquí nunca hay textos).
    function validSettings(s) {
      return s.keys().hasOnly(['storyId', 'theme', 'updatedAt'])
        && (!('storyId' in s) || s.storyId == null || (s.storyId is string && s.storyId.matches('^[a-z0-9][a-z0-9-]{1,39}$')))
        && (!('theme' in s) || s.theme in ['medianoche', 'manana', 'chicle', 'selva', 'pacifico', 'volcan']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'schemaVersion', 'settings', 'derived', 'profile'])
        && (!('profile' in request.resource.data) || validProfile(request.resource.data.profile))
        && (!('settings' in request.resource.data) || validSettings(request.resource.data.settings));
      allow delete: if isOwner(uid);

      match /events/{eventId} {
        allow read: if isOwner(uid);
        // Solo-anexar: el contenido del evento es inmutable. Un reintento (set del mismo id) solo puede
        // cambiar serverAt, así el push es idempotente sin permitir editar el evento.
        allow create: if isOwner(uid) && validEvent(eventId);
        allow update: if isOwner(uid) && validEvent(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['serverAt']);
        allow delete: if isOwner(uid);
      }

      match /exports/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
