{
  "name": "snapfit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SnapFit — PWA retro pixel-art de microsesiones de calistenia (offline-first)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:content": "node scripts/check-content.mjs",
    "screens": "node scripts/screens.mjs",
    "verify": "npm test && npm run check:content && npm run check:provenance && npm run build",
    "docs:microcopy": "node scripts/gen-microcopy.mjs"
  },
  "dependencies": {
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
